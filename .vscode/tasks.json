{
    "version": "2.0.0",
    "command": "bash",
        "args": [
          "-c"
        ],
    "tasks": [
      {
        "label": "update-ipynb",
        "type": "shell",
        "args": [
          "jupytext --to notebook ${fileDirname}/${fileBasenameNoExtension}.py --update && jupyter nbconvert --to notebook --inplace --execute ${fileDirname}/${fileBasenameNoExtension}.ipynb "
        ],
        "presentation": {
          "reveal": "always",
          "panel": "new"
        },
        "problemMatcher": []
      },
      {
        "label": "ipynb-pdf",
        "type": "shell",
        "args": [
          "jupyter nbconvert --to pdf ${fileDirname}/${fileBasenameNoExtension}.ipynb "
        ],
        "presentation": {
          "reveal": "always",
          "panel": "new"
        },
        "problemMatcher": []
      }
    ]
}


